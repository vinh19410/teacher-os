	"devDependencies": {
		"@cloudflare/workers-types": "catalog:",
		"@libsql/client": "catalog:",
		"@teacher-os/config": "workspace:*",
		"@types/node": "catalog:",
		"tsdown": "^0.22.14",
		"typescript": "catalog:",
		"vitest": "^4.1.10"
	}
