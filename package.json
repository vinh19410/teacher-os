{
	"name": "teacher-os",
	"version": "0.0.16",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "pnpm --filter web run dev:bare",
		"dev:server": "turbo run dev -F server --",
		"dev:landing": "pnpm --filter landing run dev:bare",
		"dev:student": "pnpm --filter student run dev:bare",
		"db:generate": "turbo run db:generate -F @teacher-os/db --",
		"deploy": "turbo run deploy -F @teacher-os/infra --",
		"destroy": "turbo run destroy -F @teacher-os/infra --",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "turbo run test && pnpm test:ci-workflow && pnpm test:topology-drift && pnpm test:devserver-watchdog",
		"test:ci-workflow": "node --test scripts/ci-workflow.test.mjs",
		"test:topology-drift": "node --test scripts/topology-drift.test.mjs",
		"test:devserver-watchdog": "node --test scripts/devserver-watchdog.test.mjs",
		"test:e2e": "e2e run",
		"design:compare": "node scripts/design-compare/capture.mjs"
	},
	"dependencies": {
		"@teacher-os/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@cloudflare/workers-types": "catalog:",
		"@e2e-dev/web": "^0.13.0",
		"@teacher-os/config": "workspace:*",
		"@types/node": "catalog:",
		"e2e": "^0.18.0",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.33.1"
}
