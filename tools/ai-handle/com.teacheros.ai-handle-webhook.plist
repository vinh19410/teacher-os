<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GitHub webhook fast-path receiver (localhost only; needs a tunnel or
     reverse proxy for GitHub to reach it — the 20-min poll is the fallback).
     Deployed copy:
     cp tools/ai-handle/com.teacheros.ai-handle-webhook.plist ~/Library/LaunchAgents/
     + sync tools/ai-handle/webhook_receiver.py to ~/.local/lib/teacher-os-ai-handle/
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.teacheros.ai-handle-webhook.plist -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.teacheros.ai-handle-webhook</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/python3</string>
      <string>/Users/vinhtran/.local/lib/teacher-os-ai-handle/webhook_receiver.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Users/vinhtran/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- workers are detached children: do not kill them when this job exits -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/vinhtran/.local/state/teacher-os-ai-handle/webhook-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vinhtran/.local/state/teacher-os-ai-handle/webhook-launchd.err.log</string>
  </dict>
</plist>
