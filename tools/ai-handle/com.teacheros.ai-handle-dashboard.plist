<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Local dashboard for ai-handle (127.0.0.1:8898 only). Installed and
     (re)loaded by tools/ai-handle/install.sh. -->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.teacheros.ai-handle-dashboard</string>
    <key>ProgramArguments</key>
    <array>
      <string>/opt/homebrew/bin/python3</string>
      <string>/Users/vinhtran/.local/lib/teacher-os-ai-handle/dashboard.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Users/vinhtran/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <!-- workers dispatched from the dashboard are detached children: do not
         kill them when this job restarts -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/vinhtran/.local/state/teacher-os-ai-handle/dashboard-launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vinhtran/.local/state/teacher-os-ai-handle/dashboard-launchd.err.log</string>
  </dict>
</plist>
