#!/usr/bin/env python3
"""Test stub for curl: fakes the GitHub reachability probe and the Discord
webhook; any other URL is passed to the real curl."""
import fcntl
import os
import sys

TD = os.environ.get("AI_HANDLE_TEST_DIR", "/tmp/ai-handle-test")
args = sys.argv[1:]
url = next((a for a in reversed(args) if a.startswith("http")), "")
offline = os.environ.get("AI_HANDLE_TEST_OFFLINE") == "1" or os.path.exists(TD + "/offline")
if "api.github.com" in url or "discord.test" in url or "model.test" in url:
    if offline:
        print("curl: (6) Could not resolve host", file=sys.stderr)
        sys.exit(6)
    if "discord.test" in url and "-d" in args:
        with open(TD + "/discord.log", "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX)
            f.write(args[args.index("-d") + 1].replace("\n", " ") + "\n")
    print("{}")
    sys.exit(0)
os.execv("/usr/bin/curl", ["curl"] + args)
