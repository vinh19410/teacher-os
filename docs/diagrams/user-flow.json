{
	"schema_version": 1,
	"diagram_type": "workflow",
	"meta": {
		"title": "Teacher OS — User flow hiện tại",
		"description": "Phát thảo luồng người dùng thực tế trên develop: truy cập → auth gate → đăng nhập (Google OAuth / email) → bootstrap org → nạp kernel snapshot → workspace → ghi dữ liệu qua kernel command bus. Dựa trên routes, sidebar, data-provider và PDR.",
		"views": [
			{
				"id": "ch1",
				"title": "1 · Truy cập & đăng nhập",
				"narrative": "Guard /_auth kiểm tra session trước mọi trang. Chưa đăng nhập thì redirect về /login kèm returnUrl. Đường chính là Google OAuth, dự phòng là email/mật khẩu (tab Đăng nhập/Đăng ký). Lần đầu đăng nhập, server tự bootstrap org + membership 'teacher'.",
				"focus_nodes": ["open", "d-session", "login", "d-auth", "bootstrap"]
			},
			{
				"id": "ch2",
				"title": "2 · Nạp workspace (load gate)",
				"narrative": "UI bị chặn sau load gate tới khi kernel snapshot (org-scoped) nạp xong. Lỗi mạng ban đầu hiện màn hình KernelLoadError với nút thử lại; session chết giữa phiên (401) đưa về login và quay lại đúng trang cũ.",
				"focus_nodes": ["snapshot", "d-snap", "load-err", "shell"]
			},
			{
				"id": "ch3",
				"title": "3 · Điều hướng workspace",
				"narrative": "AppShell + sidebar là hub điều hướng cố định: Dashboard (lịch hôm nay, điểm danh, học viên rủi ro), Lớp học, Học viên, Syllabus (nhập Excel/CSV), Lịch dạy, Học phí, Bài tập, Báo cáo phụ huynh. Topbar có tìm kiếm toàn cục nhảy thẳng tới học viên/lớp.",
				"focus_nodes": [
					"shell",
					"dash",
					"classes",
					"students",
					"syllabus",
					"schedule",
					"tuition",
					"assignments",
					"reports",
					"search"
				]
			},
			{
				"id": "ch4",
				"title": "4 · Ghi dữ liệu & vòng snapshot",
				"narrative": "Mọi thay đổi dữ liệu là POST-only JSON command qua kernel command bus: server validate org-scope, ghi D1, rồi client refresh snapshot để UI đồng bộ. Nếu session hết hạn giữa phiên, 401 đưa về /login và giữ returnUrl.",
				"focus_nodes": ["cmd", "d-401", "refresh", "expired", "dash"]
			}
		]
	},
