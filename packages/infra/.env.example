# Deploy configuration for teacher-os (copy to .env — never commit real values).
# Full procedure: docs/production-release-runbook.md

# Cloudflare operator credentials for Alchemy (method: env).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Deploy topology (app.<domain> + api.<domain>). Bare lowercase domain only,
# no scheme/path/port. Pass inline per deploy — teacheros.io.vn for prod,
# staging.teacheros.io.vn for staging; leave unset for local dev, which uses
# generated workers.dev URLs. Never persist it here: a leftover value would
# flip `pnpm dev` onto a domain topology.
#APP_DOMAIN=teacher-os.edu.vn

# Exact web origin the API allows via CORS. With APP_DOMAIN set it defaults to
# https://app.<APP_DOMAIN> and a disagreeing explicit value fails the run
# (prod and staging both derive it this way). With APP_DOMAIN unset, `alchemy
# dev` defaults to http://localhost:8001,http://localhost:8003 — never persist
# it here, a leftover value shadowed origins in the 2026-08-20 NO-GO.
#CORS_ORIGIN=http://localhost:8001,http://localhost:8003

# Origin cổng admin console (plan #413). Với APP_DOMAIN set, mặc định là
# https://admin.<APP_DOMAIN> và giá trị explicit thiếu origin admin fail loud.
# Dev (`alchemy dev`) mặc định http://localhost:8004. Không persist ở đây.
#ADMIN_ORIGINS=http://localhost:8004

# Danh sách email admin, phân tách dấu phẩy (plan #413). KHÔNG có default —
# rỗng = không ai là admin và không ai đăng ký được account admin trên cổng
# admin. So khớp lowercase, kiểm lại mỗi request trong requireAdmin.
#ADMIN_EMAILS=root@example.com,ops@example.com

# Values live in the operator's environment only — see the runbook secret
# inventory. Never commit real values, tokens, or database IDs.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cấu hình gửi email xác thực (Task 1.4)
# MAILER_IMPL: "log" (mặc định dev/test — in link verify ra console) | "resend" (prod)
MAILER_IMPL=log
# MAIL_FROM: địa chỉ người gửi (dev dùng onboarding@resend.dev; prod đổi thành địa chỉ trên domain đã verify với Resend)
MAIL_FROM="TeacherOS <onboarding@resend.dev>"
# RESEND_API_KEY: API key từ resend.com (bắt buộc khi MAILER_IMPL=resend)
RESEND_API_KEY=
