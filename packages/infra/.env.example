# Deploy configuration for teacher-os (copy to .env — never commit real values).
# Full procedure: docs/production-release-runbook.md

# Cloudflare operator credentials for Alchemy (method: env).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Deploy topology (app.<domain> + api.<domain>). Bare lowercase domain only,
# no scheme/path/port. Pass inline per deploy — teacheros.io.vn for prod,
# staging.teacheros.io.vn for staging; leave unset for local dev, which uses
# generated workers.dev URLs. Never persist it here: a leftover value would
# flip `pnpm dev` onto a domain topology.
#APP_DOMAIN=teacher-os.edu.vn

# Exact web origin the API allows via CORS. With APP_DOMAIN set it defaults to
# https://app.<APP_DOMAIN> and a disagreeing explicit value fails the run
# (prod and staging both derive it this way). With APP_DOMAIN unset, `alchemy
# dev` defaults to http://localhost:8001 — never persist it here, a leftover
# value shadowed origins in the 2026-08-20 NO-GO.
#CORS_ORIGIN=http://localhost:8001

# Values live in the operator's environment only — see the runbook secret
# inventory. Never commit real values, tokens, or database IDs.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
